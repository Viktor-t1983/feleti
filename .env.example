# ====== FELETI-SMOK | environment ======

# --- General ---
PROJECT_NAME=FELETI-SMOK
ENV=development
TZ=Europe/Minsk

# --- Database (PostgreSQL) ---
POSTGRES_USER=feleti
POSTGRES_PASSWORD=feleti_dev_password
POSTGRES_DB=feleti_smok
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://feleti:feleti_dev_password@db:5432/feleti_smok

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://frontend:3000
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME=FELETI-SMOK

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=feleti
MINIO_ROOT_PASSWORD=feleti_minio_password
MINIO_BUCKET=feleti-media
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- LLM extraction (опционально; если пусто — rule-based fallback) ---
# Ollama: http://localhost:11434
# OpenAI: sk-...
LLM_API_URL=
LLM_MODEL=llama3.2

# --- Telegram parser (опционально) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
